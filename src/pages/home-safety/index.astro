---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const guides = await getCollection('guides', ({ data }) => data.pillar === 'Home Safety' || data.pillar === 'Start Here');
---
<BaseLayout title="Home Safety | Aging at Home Lab" description="Room-by-room home safety checklists for aging in place.">
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Home Safety</p>
      <h1>Room-by-room safety checks for aging at home.</h1>
      <p class="lede">Start with ordinary routines: getting to the bathroom, using stairs, cooking, walking at night, answering the door, and calling for help.</p>
    </div>
  </section>

  <section class="guide-grid" aria-label="Home safety guides">
    {guides.map((guide) => (
      <article class="guide-card">
        <div class="guide-meta">
          <span class="badge">{guide.data.pillar}</span>
          <span class={guide.data.status === 'published' ? 'badge' : 'badge warning-badge'}>{guide.data.status}</span>
        </div>
        <h3><a href={`/guides/${guide.id}/`}>{guide.data.title}</a></h3>
        <p>{guide.data.description}</p>
      </article>
    ))}
  </section>

  <section class="callout">
    <h2>Coming next</h2>
    <p>Bedroom, kitchen, stairs, entryway, lighting, and trip-hazard guides will be added as this section expands.</p>
  </section>
</BaseLayout>
