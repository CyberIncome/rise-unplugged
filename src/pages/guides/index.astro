---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const guides = await getCollection('guides');
const sortedGuides = guides.sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.title.localeCompare(b.data.title));
---
<BaseLayout title="Guide Library | Aging at Home Lab" description="Browse Aging at Home Lab guides, checklists, and caregiver organization resources.">
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Guide Library</p>
      <h1>Practical guides for safer, more organized aging at home.</h1>
      <p class="lede">Browse the growing library of draft and reviewed resources for home safety, caregiver organization, senior tech, and aging-in-place planning.</p>
    </div>
  </section>

  <section class="guide-grid" aria-label="All guides">
    {sortedGuides.map((guide) => (
      <article class="guide-card">
        <div class="guide-meta">
          <span class="badge">{guide.data.pillar}</span>
          <span class={guide.data.status === 'published' ? 'badge' : 'badge warning-badge'}>{guide.data.status}</span>
        </div>
        <h3><a href={`/guides/${guide.id}/`}>{guide.data.title}</a></h3>
        <p>{guide.data.description}</p>
      </article>
    ))}
  </section>
</BaseLayout>
